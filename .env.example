# Supabase — copia este archivo a .env y rellena con tus credenciales
# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Stripe — solo la publishable key va en la app.
# La SECRET key y el webhook secret viven en la Edge Function de Supabase, NUNCA aquí.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXX
